# Copy to backend.hcl (gitignored) and fill in the values printed by
# `terraform apply` in infra/bootstrap/.
#
#   cp backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl

bucket         = "tkt-<initials>-tfstate"
key            = "ticketdesk/terraform.tfstate"
region         = "ap-south-1"
dynamodb_table = "tkt-<initials>-tflock"
encrypt        = true
