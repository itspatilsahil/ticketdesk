<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.ticketdesk</groupId>
  <artifactId>ticketdesk-api</artifactId>
  <version>1.0.0</version>
  <name>ticketdesk-api</name>
  <description>TicketDesk - minimal IT support ticket tracker API</description>

  <properties>
    <java.version>21</java.version>
    <awssdk.version>2.27.21</awssdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    Kept deliberately small: web + jpa + actuator + two JDBC drivers.
    No Lombok, no MapStruct, no Spring Cloud, no extra starters.
    Fewer dependencies = smaller jar = smaller final image = faster
    Fargate cold starts = lower cost.

    Milestone 5 adds exactly one more dependency (the S3 presigner) - see
    backend/milestones/m5-serverless-attachments/pom-additions.xml for the
    snippet to merge in at that point. Not included yet on purpose: this
    pom.xml should only ever carry what the current milestone actually uses.
  -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>

      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- H2: used only for the "default" profile (M0-M2, local dev). Not used once
         the "prod" profile (real RDS Postgres) is activated in M3. -->    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Postgres: used only when SPRING_PROFILES_ACTIVE=prod (from M3 onward) -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>ticketdesk-api</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
